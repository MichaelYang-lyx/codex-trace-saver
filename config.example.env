# codex-trace-saver — 可选配置
# 把你想设的行复制进 ~/.bashrc / ~/.zshrc / ~/.codex/.env 里。

# 你在排行榜上的显示名(默认:系统用户名)
TRACE_LEADERBOARD_NAME=your-name

# 排行榜地址(默认见下)
TRACE_LEADERBOARD_URL=http://10.9.66.12:8848

# `--local` 保存目录(默认:~/codex-traces)
# TRACE_SAVE_DIR=/path/to/traces

# 非标准 Codex 主目录(默认:~/.codex)
# CODEX_HOME=/home/you/.codex
